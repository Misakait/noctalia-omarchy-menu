#!/bin/bash
set -euo pipefail

readonly CLEANUP_RULE='r! /etc/sudoers.d/99-omarchy-nopasswd-*'
readonly TIMER_PREFIX='omarchy-nopasswd-expire'

pause_before_close() {
  if [[ -t 0 ]]; then
    printf '\nPress Enter to close...'
    read -r _ || true
  fi
}

fail() {
  printf 'Error: %s\n' "$*" >&2
  pause_before_close
  exit 1
}

if [[ ${1:-} != "--terminal" ]]; then
  (($# == 0)) || {
    printf 'Usage: %s [--terminal]\n' "$0" >&2
    exit 64
  }
  exec xdg-terminal-exec \
    --app-id=org.omarchy.terminal \
    --title="Boot-scoped Passwordless Sudo" \
    -- "$0" --terminal
fi

(($# == 1)) || fail "Invalid invocation."

username=$(id -un) || fail "Could not determine the current user."
[[ $username =~ ^[A-Za-z_][A-Za-z0-9_-]*[$]?$ ]] || \
  fail "The current user name cannot be represented safely in sudoers."

root_prefix=""
if [[ -n ${OMARCHY_MENU_TEST_ROOT:-} ]]; then
  root_prefix=$(realpath -e -- "$OMARCHY_MENU_TEST_ROOT") || \
    fail "The test root does not exist."
  [[ $root_prefix == /tmp/* && -d $root_prefix && -O $root_prefix ]] || \
    fail "The test root must be a user-owned directory below /tmp."
fi

readonly grant_path="${root_prefix}/etc/sudoers.d/99-omarchy-nopasswd-${username}"
readonly timer_name="${TIMER_PREFIX}-${username}"

stop_stock_expiry_timer() {
  sudo systemctl stop "${timer_name}.timer" "${timer_name}.service" \
    >/dev/null 2>&1 || true
}

has_boot_cleanup_rule() {
  local path line
  for path in \
    "${root_prefix}/etc/tmpfiles.d/omarchy-nopasswd-sudo.conf" \
    "${root_prefix}/run/tmpfiles.d/omarchy-nopasswd-sudo.conf" \
    "${root_prefix}/usr/local/lib/tmpfiles.d/omarchy-nopasswd-sudo.conf" \
    "${root_prefix}/usr/lib/tmpfiles.d/omarchy-nopasswd-sudo.conf"; do
    [[ -e $path || -L $path ]] || continue
    [[ -r $path ]] || return 1
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == "$CLEANUP_RULE" ]] && return 0
    done <"$path"
    return 1
  done
  return 1
}

printf 'Toggle boot-scoped passwordless sudo...\n'

if [[ -e $grant_path ]]; then
  sudo rm -f -- "$grant_path" || fail "Could not remove ${grant_path}."
  stop_stock_expiry_timer
  sudo -k
  printf '\nPasswordless sudo has been DISABLED.\n'
  printf 'Sudo will require a password again.\n'
  pause_before_close
  exit 0
fi

has_boot_cleanup_rule || fail \
  "Omarchy's boot cleanup rule is missing; refusing to create a persistent sudo grant."

printf '\n'
printf 'WARNING: This lets ANY process running as %s execute ANY command\n' "$username"
printf 'as root WITHOUT a password for the rest of this boot.\n'
printf '\n'
printf 'It remains enabled until you run this menu item again or reboot.\n'
printf 'Anyone or anything with access to this account gets full root access.\n'
printf '\n'

if ! gum confirm \
  "Enable passwordless sudo until reboot? This is a significant security risk!"; then
  printf 'Aborted. No changes made.\n'
  pause_before_close
  exit 0
fi

sudoers_tmp=$(mktemp) || fail "Could not create a temporary sudoers file."
trap 'rm -f -- "$sudoers_tmp"' EXIT
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$username" >"$sudoers_tmp"
chmod 0600 "$sudoers_tmp"

visudo -cf "$sudoers_tmp" >/dev/null || fail "The generated sudoers rule is invalid."
sudo -v || fail "Administrator authentication failed."
stop_stock_expiry_timer
sudo install -o root -g root -m 0440 -- "$sudoers_tmp" "$grant_path" || \
  fail "Could not install the sudoers rule."

if ! sudo visudo -cf "$grant_path" >/dev/null; then
  sudo rm -f -- "$grant_path" || \
    printf 'CRITICAL: remove %s as root immediately.\n' "$grant_path" >&2
  sudo -k
  fail "Installed sudoers validation failed; the grant was revoked."
fi

printf '\nPasswordless sudo has been ENABLED for this boot.\n'
printf 'Run this menu item again to disable it, or reboot the computer.\n'
pause_before_close
